-- 1. INNER JOIN: сотрудники и их должность, отделение и специальность.
SELECT ms.staff_id,
       ms.last_name,
       ms.first_name,
       jp.name AS job_position,
       d.name AS department,
       sp.name AS specialty
FROM medical_staff AS ms
JOIN job_position AS jp ON jp.position_id = ms.position_id
JOIN department_speciality AS ds
  ON ds.department_speciality_id = ms.department_speciality_id
JOIN department AS d ON d.department_id = ds.department_id
JOIN specialty AS sp ON sp.specialty_id = ds.specialty_id
ORDER BY ms.last_name, ms.first_name;

-- 2. LEFT JOIN: все пациенты, включая тех, у кого пока нет обращений/приёмов.
SELECT p.patient_id,
       p.last_name,
       p.first_name,
       mc.medical_card_id,
       a.appeal_id,
       ap.appointment_id,
       ap.appointment_at
FROM patient AS p
LEFT JOIN medical_card AS mc ON mc.patient_id = p.patient_id
LEFT JOIN appeal AS a ON a.medical_card_id = mc.medical_card_id
LEFT JOIN appointment AS ap ON ap.appeal_id = a.appeal_id
ORDER BY p.last_name, p.first_name, ap.appointment_at;

-- 3. RIGHT JOIN: все отделения и относящиеся к ним медицинские услуги.
SELECT d.department_id,
       d.name AS department,
       s.service_id,
       s.name AS service,
       s.price
FROM medical_service AS s
RIGHT JOIN department AS d ON d.department_id = s.department_id
ORDER BY d.name, s.name;

-- 4. CROSS JOIN: все сочетания отделений и типов приёма.
SELECT d.name AS department,
       vt.name AS visit_type
FROM department AS d
CROSS JOIN visit_type AS vt
ORDER BY d.name, vt.name;

-- 5. FULL OUTER JOIN: все приёмы и визиты, связанные с обращением.
-- Если для обращения нет пары, поля с другой стороны будут NULL.
SELECT COALESCE(ap.appeal_id, v.appeal_id) AS appeal_id,
       ap.appointment_id,
       ap.appointment_at,
       v.visit_id,
       v.visited_at
FROM appointment AS ap
FULL OUTER JOIN visit AS v ON v.appeal_id = ap.appeal_id
ORDER BY appeal_id, ap.appointment_at, v.visited_at;

-- 6. UNION: сотрудники, у которых есть обращение ИЛИ запись в расписании;
-- одинаковые staff_id выводятся один раз.
SELECT staff_id FROM appeal
UNION
SELECT staff_id FROM work_schedule
ORDER BY staff_id;

-- 7. UNION ALL: тот же набор источников, но повторы сохраняются.
SELECT staff_id FROM appeal
UNION ALL
SELECT staff_id FROM work_schedule
ORDER BY staff_id;

-- 8. Подзапрос / NOT EXISTS: услуги, которые ни разу не заказывали.
SELECT s.service_id, s.name, s.price
FROM medical_service AS s
WHERE NOT EXISTS (
    SELECT 1
    FROM service_order AS so
    WHERE so.service_id = s.service_id
)
ORDER BY s.name;

-- 9. LEFT JOIN + IS NULL: альтернативный вариант поиска услуг без заказов.
SELECT s.service_id, s.name, s.price
FROM medical_service AS s
LEFT JOIN service_order AS so ON so.service_id = s.service_id
WHERE so.service_order_id IS NULL
ORDER BY s.name;

-- 10. SELF JOIN: пары сотрудников с одинаковой должностью.
-- Условие staff_id < staff_id убирает пару с самим собой и зеркальные дубли.
SELECT ms1.last_name || ' ' || ms1.first_name AS employee_1,
       ms2.last_name || ' ' || ms2.first_name AS employee_2,
       jp.name AS same_job_position
FROM medical_staff AS ms1
JOIN medical_staff AS ms2
  ON ms1.position_id = ms2.position_id
 AND ms1.staff_id < ms2.staff_id
JOIN job_position AS jp ON jp.position_id = ms1.position_id
ORDER BY jp.name, employee_1, employee_2;

-- 11. Сложный запрос с подзапросом и агрегированием:
-- количество визитов по врачу, сортировка по убыванию.
SELECT staff.staff_id,
       staff.last_name,
       staff.first_name,
       COALESCE(visit_counts.visit_count, 0) AS visit_count
FROM medical_staff AS staff
LEFT JOIN (
    SELECT a.staff_id, COUNT(v.visit_id) AS visit_count
    FROM appeal AS a
    JOIN visit AS v ON v.appeal_id = a.appeal_id
    GROUP BY a.staff_id
) AS visit_counts ON visit_counts.staff_id = staff.staff_id
ORDER BY visit_count DESC, staff.last_name, staff.first_name;

-- 12. Соединение нескольких таблиц: визиты и все диагнозы визита.
-- Составной ключ visit_diagnosis (visit_id, diagnosis_id) позволяет указать несколько диагнозов.
SELECT v.visit_id,
       v.visited_at,
       vt.name AS visit_type,
       d.name AS diagnosis,
       vd.is_primary
FROM visit AS v
JOIN visit_type AS vt ON vt.visit_type_id = v.visit_type_id
JOIN visit_diagnosis AS vd ON vd.visit_id = v.visit_id
JOIN diagnosis AS d ON d.diagnosis_id = vd.diagnosis_id
ORDER BY v.visited_at DESC, v.visit_id, vd.is_primary DESC, d.name;

-- 13. Условие «значение 1 или 2» и сортировка по дате:
-- записи на приём со статусом 1 или 2.
SELECT ap.appointment_id,
       ap.appointment_at,
       st.name AS appointment_status,
       ap.appeal_id
FROM appointment AS ap
JOIN appointment_status AS st ON st.status_id = ap.status_id
WHERE ap.status_id IN (1, 2)
ORDER BY ap.appointment_at DESC;

-- 14. Подсчёт визитов по типу, по убыванию количества.
SELECT vt.name AS visit_type,
       COUNT(v.visit_id) AS visit_count
FROM visit_type AS vt
LEFT JOIN visit AS v ON v.visit_type_id = vt.visit_type_id
GROUP BY vt.visit_type_id, vt.name
ORDER BY visit_count DESC, vt.name;




-- 15. CROSS JOIN через перечисление таблиц через запятую.
-- Результат такой же, как у запроса 4.
SELECT d.name AS department,
       vt.name AS visit_type
FROM department AS d, visit_type AS vt
ORDER BY d.name, vt.name;

-- 16. CROSS JOIN через JOIN ... ON TRUE.
-- В PostgreSQL для обычного JOIN условие ON обязательно; TRUE даёт декартово произведение.
SELECT d.name AS department,
       vt.name AS visit_type
FROM department AS d
JOIN visit_type AS vt ON TRUE
ORDER BY d.name, vt.name;

-- 17. INNER JOIN с USING: общий столбец appeal_id у appointment и visit указывается один раз.
SELECT appeal_id,
       ap.appointment_id,
       ap.appointment_at,
       v.visit_id,
       v.visited_at
FROM appointment AS ap
INNER JOIN visit AS v USING (appeal_id)
ORDER BY appeal_id;

-- 18. Правое антисоединение: заказы, для которых не найдена медицинская услуга.
-- При включённом внешнем ключе результат обычно пустой.
SELECT so.service_order_id, so.service_id
FROM medical_service AS s
RIGHT JOIN service_order AS so ON so.service_id = s.service_id
WHERE s.service_id IS NULL
ORDER BY so.service_order_id;

-- 19. То же правое антисоединение с помощью NOT EXISTS.
SELECT so.service_order_id, so.service_id
FROM service_order AS so
WHERE NOT EXISTS (
    SELECT 1
    FROM medical_service AS s
    WHERE s.service_id = so.service_id
)
ORDER BY so.service_order_id;

-- 20. Эмуляция FULL OUTER JOIN через LEFT JOIN и RIGHT JOIN с UNION.
-- UNION удаляет повторные совпавшие строки.
SELECT COALESCE(ap.appeal_id, v.appeal_id) AS appeal_id,
       ap.appointment_id,
       ap.appointment_at,
       v.visit_id,
       v.visited_at
FROM appointment AS ap
LEFT JOIN visit AS v ON v.appeal_id = ap.appeal_id
UNION
SELECT COALESCE(ap.appeal_id, v.appeal_id) AS appeal_id,
       ap.appointment_id,
       ap.appointment_at,
       v.visit_id,
       v.visited_at
FROM appointment AS ap
RIGHT JOIN visit AS v ON v.appeal_id = ap.appeal_id
ORDER BY appeal_id, appointment_at, visited_at;

-- 21. Только несовпавшие строки FULL OUTER JOIN (обе стороны), через UNION.
SELECT ap.appeal_id,
       ap.appointment_id,
       ap.appointment_at,
       v.visit_id,
       v.visited_at
FROM appointment AS ap
LEFT JOIN visit AS v ON v.appeal_id = ap.appeal_id
WHERE v.visit_id IS NULL
UNION
SELECT v.appeal_id,
       NULL::bigint AS appointment_id,
       NULL::timestamptz AS appointment_at,
       v.visit_id,
       v.visited_at
FROM visit AS v
LEFT JOIN appointment AS ap ON ap.appeal_id = v.appeal_id
WHERE ap.appointment_id IS NULL
ORDER BY appeal_id, appointment_at, visited_at;
